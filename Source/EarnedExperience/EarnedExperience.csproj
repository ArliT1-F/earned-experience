<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EarnedExperience</AssemblyName>
    <RootNamespace>EarnedExperience</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ArliT1-F</Authors>
    <Description>Awards skill XP for meaningful work that vanilla overlooks.</Description>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Output to mod Assemblies folder for in-place testing -->
    <OutputPath>../../Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- RimWorld and Unity references – set RIMWORLD_DIR env var or edit HintPath -->
    <!-- Example Windows: C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed -->
    <!-- Example Linux:   ~/.steam/steam/steamapps/common/RimWorld/RimWorldLinux_Data/Managed -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RIMWORLD_DIR)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RIMWORLD_DIR)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RIMWORLD_DIR)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RIMWORLD_DIR)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RIMWORLD_DIR)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Fallback stubs when building without RimWorld installed (CI / docs review) -->
  <ItemGroup Condition="!Exists('$(RIMWORLD_DIR)/Assembly-CSharp.dll')">
    <!-- No references – compilation will be skipped in CI; files are validated as text -->
  </ItemGroup>
</Project>